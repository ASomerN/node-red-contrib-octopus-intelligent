r style=\"background:#f5f5f5;\">\n          <td style=\"padding:6px 10px;\">Gas standing charge</td>\n          <td style=\"padding:6px 10px; text-align:right;\">{{ msg.payload.gas_standing_charge != null ? msg.payload.gas_standing_charge + ' p/day' : '--' }}</td>\n        </tr>\n      </tbody>\n    </table>\n  </div>\n</template>",

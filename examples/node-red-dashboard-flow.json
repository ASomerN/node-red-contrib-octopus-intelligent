    "id": "widget-opt-schedule-template",
    "type": "ui-template",
    "z": "tab-octopus-main",
    "group": "ui-group-opt-schedule",
    "name": "Rate Schedule (applicable_rates)",
    "order": 1,
    "width": "12",
    "height": "6",
    "className": "",
    "template": "<template>\n  <div style=\"font-size:0.85em; max-height:300px; overflow-y:auto;\">\n    <div style=\"margin-bottom:6px; font-weight:bold;\">Applicable Rates Schedule ({{ (msg.payload.applicable_rates || []).length }} slots)</div>\n    <table style=\"width:100%; border-collapse:collapse;\">\n      <thead>\n        <tr style=\"background:#1565C0; color:#fff; position:sticky; top:0;\">\n          <th style=\"padding:4px 8px; text-align:left;\">From</th>\n          <th style=\"padding:4px 8px; text-align:left;\">To</th>\n          <th style=\"padding:4px 8px; text-align:right;\">p/kWh</th>\n          <th style=\"padding:4px 8px; text-align:center;\">Level</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr\n          v-for=\"(slot, i) in (msg.payload.applicable_rates || [])\"\n          :key=\"i\"\n          :style=\"{ background: i % 2 === 0 ? '#f5f5f5' : '#fff' }\"\n        >\n          <td style=\"padding:4px 8px;\">{{ new Date(slot.valid_from).toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'}) }}</td>\n          <td style=\"padding:4px 8px;\">{{ new Date(slot.valid_to).toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'}) }}</td>\n          <td style=\"padding:4px 8px; text-align:right; font-weight:bold;\">{{ slot.value_pence_per_kwh }}</td>\n          <td style=\"padding:4px 8px; text-align:center;\">\n            <span :style=\"{\n              display:'inline-block',\n              width: Math.min(60, Math.max(4, (slot.value_pence_per_kwh / (msg.payload.applicable_rates_max_pence || 50)) * 60)) + 'px',\n              height:'10px',\n              background: slot.value_pence_per_kwh <= (msg.payload.applicable_rates_min_pence || 0) ? '#00897B' :\n                          slot.value_pence_per_kwh >= (msg.payload.applicable_rates_max_pence || 50) ? '#EF5350' : '#FFA726',\n              borderRadius:'3px'\n            }\"></span>\n          </td>\n        </tr>\n      </tbody>\n    </table>\n  </div>\n</template>",

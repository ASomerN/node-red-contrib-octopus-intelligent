    "template": "<template>\n  <div style=\"font-size:0.9em;\">\n    <table style=\"width:100%; border-collapse:collapse;\">\n      <thead>\n        <tr style=\"background:#1565C0; color:#fff;\">\n          <th style=\"padding:6px 10px; text-align:left;\">Metric</th>\n          <th style=\"padding:6px 10px; text-align:right;\">Import (p/kWh)</th>\n          <th style=\"padding:6px 10px; text-align:right;\">Export (p/kWh)</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr style=\"background:#f5f5f5;\">\n          <td style=\"padding:6px 10px;\">Current</td>\n          <td style=\"padding:6px 10px; text-align:right;\">{{ msg.payload.applicable_rates_current_pence ?? '--' }}</td>\n          <td style=\"padding:6px 10px; text-align:right;\">{{ msg.payload.electricity_export_rate_current_pence ?? '--' }}</td>\n        </tr>\n        <tr>\n          <td style=\"padding:6px 10px;\">Min</td>\n          <td style=\"padding:6px 10px; text-align:right;\">{{ msg.payload.applicable_rates_min_pence ?? '--' }}</td>\n          <td style=\"padding:6px 10px; text-align:right;\">{{ msg.payload.electricity_export_rate_min_pence ?? '--' }}</td>\n        </tr>\n        <tr style=\"background:#f5f5f5;\">\n          <td style=\"padding:6px 10px;\">Median</td>\n          <td style=\"padding:6px 10px; text-align:right;\">{{ msg.payload.applicable_rates_median_pence ?? '--' }}</td>\n          <td style=\"padding:6px 10px; text-align:right;\">{{ msg.payload.electricity_export_rate_median_pence ?? '--' }}</td>\n        </tr>\n        <tr>\n          <td style=\"padding:6px 10px;\">Avg</td>\n          <td style=\"padding:6px 10px; text-align:right;\">{{ msg.payload.applicable_rates_avg_pence ?? '--' }}</td>\n          <td style=\"padding:6px 10px; text-align:right;\">{{ msg.payload.electricity_export_rate_avg_pence ?? '--' }}</td>\n        </tr>\n        <tr style=\"background:#f5f5f5;\">\n          <td style=\"padding:6px 10px;\">Max</td>\n          <td style=\"padding:6px 10px; text-align:right;\">{{ msg.payload.applicable_rates_max_pence ?? '--' }}</td>\n          <td style=\"padding:6px 10px; text-align:right;\">{{ msg.payload.electricity_export_rate_max_pence ?? '--' }}</td>\n        </tr>\n        <tr>\n          <td style=\"padding:6px 10px; color:#888; font-size:0.85em;\">Next slot from</td>\n          <td style=\"padding:6px 10px; text-align:right; color:#888; font-size:0.85em;\">{{ msg.payload.applicable_rates_next_from ? new Date(msg.payload.applicable_rates_next_from).toLocaleTimeString() : '--' }} @ {{ msg.payload.applicable_rates_next_pence ?? '--' }}p</td>\n          <td style=\"padding:6px 10px; text-align:right; color:#888; font-size:0.85em;\">{{ msg.payload.electricity_export_rate_next_from ? new Date(msg.payload.electricity_export_rate_next_from).toLocaleTimeString() : '--' }} @ {{ msg.payload.electricity_export_rate_next_pence ?? '--' }}p</td>\n        </tr>\n      </tbody>\n    </table>\n  </div>\n</template>",

    "id": "fn-controls-status",
    "type": "function",
    "name": "Extract current confirmed settings for Controls page",
    "z": "tab-octopus-main",
    "func": "// Provides a status summary text for the Controls page.\nmsg.payload = [\n    'Confirmed limit: ' + (msg.payload.confirmed_limit || '--') + '%',\n    'Confirmed time: ' + (msg.payload.confirmed_time || '--'),\n    'Smart charging: ' + (msg.payload.smart_charging ? 'ON' : 'OFF'),\n    'Charging now: ' + (msg.payload.charging_now ? 'YES' : 'NO')\n].join(' | ');\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 760,
    "y": 60,
    "wires": [["widget-controls-status"]]
  },
  {
    "id": "fn-find-cheapest-window",
    "type": "function",
    "name": "find-cheapest-window [SAMPLE — edit freely]",
    "z": "tab-octopus-main",
    "func": "// SAMPLE — user-modifiable. Demonstrates how to derive a \"cheapest contiguous\n// N-hour window\" from the applicable_rates array. The Octopus node does NOT\n// publish this as a sensor by design — the API returns the raw array; YOU\n// decide what window logic matters for your use case.\n//\n// Modify DURATION_MINS below or wire to a ui-number-input on the page.\nconst DURATION_MINS = 180;  // 3 hours — change this to suit your needs\nconst slots = msg.payload.applicable_rates || [];\nconst now = Date.now();\n\n// Filter to slots with non-null values, sort by valid_from.\nconst valid = slots\n    .filter(s => s.value_pence_per_kwh !== null && s.value_pence_per_kwh !== undefined)\n    .sort((a, b) => new Date(a.valid_from) - new Date(b.valid_from));\n\n// Group into contiguous runs (slot.valid_to === next slot.valid_from).\nconst runs = [];\nlet run = [];\nfor (const s of valid) {\n    if (run.length === 0) { run.push(s); continue; }\n    const prev = run[run.length - 1];\n    if (new Date(s.valid_from).getTime() === new Date(prev.valid_to).getTime()) {\n        run.push(s);\n    } else {\n        runs.push(run);\n        run = [s];\n    }\n}\nif (run.length) runs.push(run);\n\n// For each run, slide a continuous N-minute window and pick the lowest avg.\nconst durationMs = DURATION_MINS * 60 * 1000;\nlet best = null;\nfor (const r of runs) {\n    const candidates = new Set();\n    candidates.add(new Date(r[0].valid_from).getTime());\n    for (let i = 1; i < r.length; i++) candidates.add(new Date(r[i].valid_from).getTime());\n    candidates.add(new Date(r[r.length - 1].valid_to).getTime() - durationMs);\n    for (const winStart of candidates) {\n        if (winStart < now) continue;\n        const winEnd = winStart + durationMs;\n        if (winEnd > new Date(r[r.length - 1].valid_to).getTime()) continue;\n        let weighted = 0;\n        for (const slot of r) {\n            const sStart = new Date(slot.valid_from).getTime();\n            const sEnd   = new Date(slot.valid_to).getTime();\n            const overlap = Math.max(0, Math.min(winEnd, sEnd) - Math.max(winStart, sStart));\n            if (overlap > 0) weighted += slot.value_pence_per_kwh * (overlap / durationMs);\n        }\n        if (!best || weighted < best.avg) {\n            best = {\n                start: new Date(winStart).toISOString(),\n                end:   new Date(winEnd).toISOString(),\n                avg:   parseFloat(weighted.toFixed(4)),\n            };\n        }\n    }\n}\n\nmsg.payload = {\n    cheapest_window: best || null,\n    duration_mins: DURATION_MINS,\n};\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 470,
    "y": 160,
    "wires": [["widget-opt-cheapest-window"]]
  },
  {
    "id": "fn-is-cheapest-now",
    "type": "function",
    "name": "is-cheapest-now [SAMPLE — edit freely]",
    "z": "tab-octopus-main",
    "func": "// SAMPLE — user-modifiable. Returns true when the current applicable rate\n// equals the minimum in the next 24h schedule. Use as an automation trigger:\n// \"start the dishwasher when we hit the cheapest rate of the day.\"\n//\n// Extend this: add a trigger node downstream, or wire to a ui-switch for\n// a visual indicator that lights up when now is the cheapest moment.\nconst currentRate = msg.payload.applicable_rates_current_pence;\nconst minRate     = msg.payload.applicable_rates_min_pence;\nmsg.payload = {\n    is_cheapest_now: currentRate !== null && minRate !== null && currentRate === minRate,\n    current_pence:   currentRate,\n    min_pence:       minRate,\n};\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 470,
    "y": 220,
    "wires": [["widget-opt-cheapest-now"]]
  },
  {
    "id": "fn-apply-limit",
    "type": "function",
    "name": "Wrap limit as set_limit command",
    "z": "tab-octopus-main",
    "func": "// Receives the slider value from ui-number-input and wraps it\n// into the command shape expected by the Octopus Intelligent node.\nconst val = parseInt(msg.payload, 10);\nif (isNaN(val) || val < 50 || val > 100) {\n    node.warn('Invalid limit value: ' + msg.payload);\n    return null;\n}\nmsg.payload = { set_limit: val };\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 760,
    "y": 280,
    "wires": [["node-octopus-main"]]
  },

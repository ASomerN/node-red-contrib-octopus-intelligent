    "className": "",
    "template": "<template>\n  <div style=\"font-size:0.85em;\">\n    <div style=\"font-weight:bold; margin-bottom:6px;\">Per-Category Errors (null = healthy)</div>\n    <table style=\"width:100%; border-collapse:collapse;\">\n      <thead>\n        <tr style=\"background:#37474F; color:#fff;\">\n          <th style=\"padding:4px 8px; text-align:left;\">Category</th>\n          <th style=\"padding:4px 8px; text-align:left;\">Status</th>\n        </tr>\n      </thead>\n      <tbody>\n        <template v-for=\"(key, i) in [\n          'intelligent_error', 'electricity_tariff_error', 'electricity_consumption_error',\n          'electricity_export_rate_error', 'electricity_export_consumption_error',\n          'gas_tariff_error', 'gas_consumption_error',\n          'account_error', 'octoplus_error', 'saving_sessions_error',\n          'free_electricity_error', 'wheel_of_fortune_error',\n          'home_mini_error', 'update_check_error', 'applicable_rates_error'\n        ]\" :key=\"i\">\n          <tr v-if=\"msg.payload[key] != null\"\n              :style=\"{ background: i % 2 === 0 ? '#fff3f3' : '#ffe0e0' }\">\n            <td style=\"padding:4px 8px; font-weight:bold;\">{{ key.replace('_error','') }}</td>\n            <td style=\"padding:4px 8px; color:#c62828;\">{{ msg.payload[key] }}</td>\n          </tr>\n        </template>\n        <tr v-if=\"Object.keys(msg.payload).filter(k => k.endsWith('_error') && msg.payload[k] != null).length === 0\">\n          <td colspan=\"2\" style=\"padding:10px; text-align:center; color:#00897B; font-weight:bold;\">All categories healthy</td>\n        </tr>\n      </tbody>\n    </table>\n  </div>\n</template>",
